    "pg-hstore": "^2.3.4",
    "prom-client": "^14.1.0",
    "sequelize": "^6.21.4",
    "sqlite3": "^5.0.11",
    "uuid": "^9.0.0",
    "winston": "^3.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
